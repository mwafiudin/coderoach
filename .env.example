# Copy to .env.local for development. Every value here is an example, never a real secret.
# Docker/VPS: the same names are passed at `docker run`, except NEXT_PUBLIC_* (see below).

# ── Runtime (the web server) ──────────────────────────────────────────────

# Payload. Required in production: the server refuses to start without it.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Postgres connection string. The app reads DATABASE_URI first and falls back to DATABASE_URL,
# so set one. DATABASE_URI is the documented name; DATABASE_URL is accepted because that is what
# Railway and most hosts expose (on Railway: DATABASE_URI=${{Postgres.DATABASE_URL}}).
DATABASE_URI=postgresql://user:password@host/db?sslmode=require

# Media uploads are written to ./media, relative to the working directory.
# Railway: a volume at /app/media. Docker: a volume at /app/media (docs/self-host.md).

# Payload job crons for the live-link checks (ADR 0007). Only "on" enables them, and only in production.
PORTFOLIO_LINKCHECK=

# Email via Resend (https://resend.com). Without the key no email adapter is configured.
# Free tier: 100/day. Used for contact form notifications + admin emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com
RESEND_TO_EMAIL=hello@example.com

# Cloudflare Turnstile secret (Turnstile → Add site). While the site key and this are empty,
# the OpsScore gate and the brief form work without the check.
TURNSTILE_SECRET_KEY=

# ── Build time (NEXT_PUBLIC_*) ────────────────────────────────────────────
# Inlined into the bundle by `next build`: changing one needs a rebuild/redeploy, not a restart.
# Docker passes them as --build-arg.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Branding (also editable in admin → Site Settings — these are first-boot fallbacks)
NEXT_PUBLIC_SITE_NAME=Studio

# Analytics — site-wide, loaded only when set. OpsScore funnel events go to both.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Turnstile site key, the public half of TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Offline presentation at /work/presentasi (ADR 0008). Only "on" builds the service worker;
# anything else unregisters it (the kill switch).
NEXT_PUBLIC_PRESENTASI_OFFLINE=

# ── Scripts only (npm run seed, scripts/*.ts) — never needed by the server ─

# npm run seed clears and rewrites most collections. It only runs with this set, on a local database.
SEED_TARGET=local

# scripts/portfolio-sync.ts reads portfolio permissions from Coderoach OS (ADR 0010).
# The token has the read:portofolio scope only (docs/portfolio-ops.md). Never print it.
CODEROACH_OS_URL=https://coderoach-os.vercel.app
CODEROACH_OS_TOKEN=

# scripts/opsscore-og.ts renders the OG images with a local Chrome.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
